# Copiar a .streamlit/secrets.toml (local) o configurar en Streamlit Cloud → Secrets

# Solo la URL base del proyecto (SIN /rest/v1 al final)
SUPABASE_URL = "https://TU_PROYECTO.supabase.co"
SUPABASE_ANON_KEY = "tu-anon-key"

# Solo para scripts de migración local (scripts/seed_from_sheet.py)
# Supabase → Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY = "tu-service-role-key"

# Backup / restore local (backups/backup_db.ps1)
# NO es lo mismo que SUPABASE_URL (API HTTP).
#
# Opción A — contraseña + región (Windows / IPv4):
# SUPABASE_DB_PASSWORD = "contraseña-de-database"
# SUPABASE_DB_REGION = "sa-east-1"
# (Región en Supabase → Database → Connect → Session pooler)
#
# Opción B — URI completa del panel Connect (recomendado si A falla):
# SUPABASE_DB_URL = "postgresql://postgres.[ref]:...@aws-0-....pooler.supabase.com:5432/postgres"

# Alternativa al service role: credenciales del usuario asistente
# ASISTENTE_EMAIL = "asistente@tu-dominio.com"
# ASISTENTE_PASSWORD = "tu-contraseña"
