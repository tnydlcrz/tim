# Copiar a .streamlit/secrets.toml (local) o configurar en Streamlit Cloud → Secrets

# Solo la URL base del proyecto (SIN /rest/v1 al final)
SUPABASE_URL = "https://TU_PROYECTO.supabase.co"
SUPABASE_ANON_KEY = "tu-anon-key"

# Solo para scripts de migración local (scripts/seed_from_sheet.py)
# Supabase → Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY = "tu-service-role-key"

# Alternativa al service role: credenciales del usuario asistente
# ASISTENTE_EMAIL = "asistente@tu-dominio.com"
# ASISTENTE_PASSWORD = "tu-contraseña"
